# --- Local development (copy to .env, then: npm run dev) ---
# Maps: one key works for a hackathon; ideally use two (server key restricted by API, browser key restricted by HTTP referrer)
MAPS_SERVER_KEY=
MAPS_BROWSER_KEY=
# Optional: a Map ID from Cloud Console > Google Maps Platform > Map management (vector). DEMO_MAP_ID works for testing.
MAP_ID=DEMO_MAP_ID

# Gemini – EITHER an AI Studio key for local dev...
GEMINI_API_KEY=
# ...OR Vertex AI with your gcloud login (gcloud auth application-default login):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Backup models used automatically when the main model is overloaded (503) – comma-separated
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest

# Storage: memory locally; Firestore on Cloud Run
USE_FIRESTORE=false
